/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include <stdint.h>
#include "platform.h"
#include "xil_printf.h"
#include "xparameters.h"
#include "xil_io.h"

#define FIFO_BASE_ADDR (0x43C10000)
//#define A_REG_ADDR (MULT_BASE_ADDR + 0x00)
//#define B_REG_ADDR (MULT_BASE_ADDR + 0x04)
//#define P_REG_ADDR (MULT_BASE_ADDR + 0x08)
//#define BRAM_BASE_ADDR (0x40000000)
#define FPGA_REV_REG_ADDR   (FIFO_BASE_ADDR + 0x00)
#define FIFO_RST_REG_ADDR   (FIFO_BASE_ADDR + 0x04)
#define WR_DATA_REG_ADDR    (FIFO_BASE_ADDR + 0x08)
#define RD_REQ_REG_ADDR     (FIFO_BASE_ADDR + 0x0C)
#define RD_DATA_REG_ADDR    (FIFO_BASE_ADDR + 0x10)
#define STATUS_REG_ADDR     (FIFO_BASE_ADDR + 0x14)
#define DATA_COUNT_REG_ADDR (FIFO_BASE_ADDR + 0x18)
#define CONFIG_REG_ADDR     (FIFO_BASE_ADDR + 0x1C)
#define THRESHOLD_REG_ADDR  (FIFO_BASE_ADDR + 0x20)

#define STATUS_EMPTY          (1u << 0)
#define STATUS_FULL           (1u << 1)
#define STATUS_ALMOST_EMPTY   (1u << 2)
#define STATUS_ALMOST_FULL    (1u << 3)
#define STATUS_RD_VALID       (1u << 4)

#define FIFO_DEPTH     (32)
#define NUM_WORDS      (32)
#define RD_TIMEOUT     (1000)

void fifo_push(uint32_t data)
{
	Xil_Out32(WR_DATA_REG_ADDR, data);
}

int fifo_pop(uint32_t *data)
{
	Xil_Out32(RD_DATA_REG_ADDR, 0x1);

	for (uint32_t t = 0; t < RD_TIMEOUT; t++)
	{
		if (XIL_In32(STATUS_REG_ADDR) && STATUS_RD_VALID)
		{
			*data = Xil_In32(RD_DATA_REG_ADDR);
			return 0;
		}
	}
	return -1;
}

void print_status(void)
{
	uint32_t status = Xil_In32(STATUS_REG_ADDR);
	uint32_t count = Xil_In32(DATA_COUNT_REG_ADDR);
	xil_printf(" STATUS = 0x%08x | COUNT = %d | EMPTY = %d | AE = %d | AF = %d | FULL = %d\n",
			status, count,
			(status & STATUS_EMPTY) ? 1 : 0,
		    (status & STATUS_ALMOST_EMPTY) ? 1 : 0,
		    (status & STATUS_ALMOST_FULL) ? 1 : 0,
		    (status & STATUS_FULL) ? 1 : 0);
}
int main()
{
    init_platform();

    xil_printf ("ECE 520/l _ Custom AXI Ip Lab - Evelyn Dominguez\n");
    xil_printf("Start of FIFO Test\n");

    uint32_t wr_val = 0;
    uint32_t fifo_val = 0;
    uint32_t errors = 0;

    uint32_t rev_val = Xil_In32(FPGA_REV_REG_ADDR);
    uint32_t config_val = Xil_In32(CONFIG_REG_ADDR);
    uint32_t threshold_val = Xil_In32(THRESHOLD_REG_ADDR);

    xil_printf("\nFPGA Revision: 0x%08x\n", rev_val);
    xil_printf("FIFO Parameters: WIDTH = %d, DEPTH = %d, READ_LATENCY = %d\n",
    		(config_val & 0xFF), ((config_val >> 8)&0xFFFF), ((config_val >> 24)& 0xF));
    xil_printf("FIFO Thresholds: ALMOST_EMPTY = %d, ALMOST_FULL = %d\n",
    		(threshold_val & 0xFFFF), ((threshold_val >> 16)&0xFFFF));

    Xil_Out32(FIFO_RST_REG_ADDR, 0x1);

    xil_printf("\nAfter FIFO Reset: \n");
    print_status();

    if((Xil_In32(STATUS_REG_ADDR)!= 0x05) || (Xil_In32(DATA_COUNT_REG_ADDR)!= 0))
    {
    	xil_printf(" ERROR: FIFO is not empty after reset\n");
    	errors++;

    }

    xil_printf("\nWriting to FIFO:\n");
    for (uint32_t i = 1; i <= NUM_WORDS; i++)
    {
    	wr_val = i * i;
    	fifo_push(wr_val);

    	xil_printf("Pushed: %d\n", wr_val);
    	print_status();
    }

    if (!(Xil_In32(STATUS_REG_ADDR) & STATUS_FULL) || (Xil_In32(DATA_COUNT_REG_ADDR) != FIFO_DEPTH))
		{
			xil_printf("ERROR: FIFO is not full after %d writes\n", NUM_WORDS);
			errors++;
		}
    xil_printf("\nFIFO Contents: \n");

    for(uint32_t k = 1; k <= NUM_WORDS; k++)
    {
    	if (fifo_pop(&fifo_val)!= 0)
    	{
    		xil_printf("EROR: Read %d timed out (RD_VALID not set)\n", k);
    		errors++;
    		continue;
    	}
    	if (fifo_val == (k *k))
    	{
    		xil_printf("FIFO[%d] = %d\n", (k-1), fifo_val);
    	}
    	else
    	{
    		xil_printf("FIFO[%d] = %d (ERROR:expected %d)\n", (k-1), fifo_val, (k*k));
    		errors++;
    	}

    }

    xil_printf("\nAfter Reading All Words:\n");
    print_status();

    if (!(Xil_In32(STATUS_REG_ADDR) & STATUS_EMPTY) || (Xil_In32(DATA_COUNT_REG_ADDR) != 0))
    {
    	xil_printf("ERROR: FIFO is not empty after %d reads\n", NUM_WORDS);
    	errors++;
    }

    if (errors == 0)
    {
    	xil_printf("\nFIFO test PASSED (0 errors)\n");
    }
    else
    {
    	xil_printf("\nFIFO test FAILED (%d errors)\n", errors);
    }
    xil_printf("End of FIFO Test\n");

    cleanup_platform();
    return 0;
}
