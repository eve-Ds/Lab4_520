/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include <stdint.h>
#include "platform.h"
#include "xil_printf.h"
#include "xparameters.h"
#include "xil_io.h"

#define MULT_BASE_ADDR  (0x43C00000)
#define A_REG_ADDR      (MULT_BASE_ADDR + 0x00)
#define B_REG_ADDR      (MULT_BASE_ADDR + 0x04)
#define P_REG_ADDR      (MULT_BASE_ADDR + 0x08)
#define BRAM_BASE_ADDR (0x40000000)

int main()
{
    uint32_t a_val;
    uint32_t b_val;
    uint32_t p_val;
    uint32_t k;
    uint32_t bram_val;

    init_platform();
    xil_printf("ECE 520/L - Custom AXI IP Lab - Evelyn Dominguez\n");
    xil_printf("Start of Multiplier + BRAM Test\n");

    //32 Multiplication operations and store product in BRAM using word-addressing
    for (k = 0; k < 32; k++)
    {
    	// 1, 2 ,3 ... 32
    	a_val = k + 1;
    	b_val = k + 2;

    	Xil_Out32(A_REG_ADDR, a_val);
    	Xil_Out32 (B_REG_ADDR, b_val);

    	//stores the product
    	p_val = Xil_In32(P_REG_ADDR);

    	//BRAM base address for entry k:
    	Xil_Out32(BRAM_BASE_ADDR + (k * 4), p_val);

    	xil_printf("Store %d * %d = %d at BRAM[%d]\r\n", a_val, b_val, p_val,k);
    }
    xil_printf("BRAM Contents:\n");

    for (k = 0; k < 32; k++)
    {
    	bram_val = Xil_In32(BRAM_BASE_ADDR + (k*4));

    	xil_printf("BRAM[%d] = %d\r\n", k, bram_val);
    }

    xil_printf("End of Multiplier + BRAM Test\n");

    cleanup_platform();
    return 0;
}
